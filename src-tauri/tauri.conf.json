{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EdgeBridge KVM",
  "version": "0.4.2",
  "identifier": "org.edgebridge.kvm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "EdgeBridge KVM", "width": 760, "height": 750, "minWidth": 380, "minHeight": 540 }],
    "security": { "capabilities": ["main-session"], "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:", "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFQkE2RjlBRkVFMzYzNzQKUldSMFkrUCttbSs2dmpkK2V0bXJwQS9oV0t5anpheWo1d1lzRXlNSXBrQnNsQjJZNkZEaURWKzcK",
      "endpoints": ["https://github.com/tomigarbarino/edgebridge-kvm/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "licenseFile": "../LICENSE",
    "resources": { "../docs/third-party-notices.txt": "THIRD_PARTY_NOTICES.txt", "../docs/licenses/rust-library.html": "RUST_LIBRARY_NOTICES.html" },
    "windows": { "nsis": { "installMode": "currentUser", "installerHooks": "windows/update-hooks.nsh" } }
  }
}
